+{
+namespace ps4
+{
+
+std::string getExecutablePath()
+{
+	// El loader monta el paquete en /app0 y el ejecutable siempre se llama asi.
+	return "/app0/eboot.bin";
+}
+
+std::string getUserDirectory()
+{
+	// /data es el unico arbol escribible que ve un homebrew. Se crea una vez y
+	// se cachea: setupWriteDirectory() compara este prefijo contra save_path_full
+	// para decidir si la plataforma es "sandboxed", y lo es.
+	static std::string dir;
+	if (dir.empty())
+	{
+		mkdir(LOVE_PS4_DATA_DIR, 0777);
+		dir = LOVE_PS4_DATA_DIR "/";
+	}
+	return dir;
+}
+
+std::string getLoveInResources(bool &fused)
+{
+	// ⚠ /app0 ANTES QUE /data (release, 23-sep). Un paquete FUSIONADO (runtime +
+	// game.love, lo que arma tools/fuse-pkg.sh) corre SIEMPRE su propio juego:
+	// antes, un game.love suelto en /data/love le ganaba y el paquete de un juego
+	// arrancaba otro. El runtime generico no trae juego en /app0, asi que para el
+	// sigue valiendo /data/love/game.love, y con el el ciclo de trabajo de
+	// siempre: subir el .love por FTP en segundos, sin reempaquetar.
+	static const char *candidates[] = {
+		"/app0/game.love",
+		"/app0/main.lua",
+		LOVE_PS4_DATA_DIR "/game.love",
+		LOVE_PS4_DATA_DIR "/main.lua",
+	};
+
+	for (const char *path : candidates)
+	{
+		struct stat st;
+		if (stat(path, &st) == 0 && S_ISREG(st.st_mode))
+		{
+			fused = true;
+			// main.lua significa modo directorio: se monta la carpeta que lo
+			// contiene, no el archivo.
+			std::string p(path);
+			size_t slash = p.rfind('/');
+			if (p.find("main.lua") != std::string::npos && slash != std::string::npos)
+				return p.substr(0, slash);
+			return p;
+		}
+	}
+
+	fused = false;
+	return std::string();
+}
+
+static void openPermissionsAt(const std::string &path, int depth)
+{
+	struct stat st;
+	if (lstat(path.c_str(), &st) != 0)
+		return;
+	if (S_ISDIR(st.st_mode))
+	{
+		if ((st.st_mode & 0777) != 0777)
+			chmod(path.c_str(), 0777);
+		if (depth >= 32)
+			return;
+		DIR *d = opendir(path.c_str());
+		if (!d)
+			return;
+		while (struct dirent *e = readdir(d))
+		{
+			if (std::strcmp(e->d_name, ".") == 0 || std::strcmp(e->d_name, "..") == 0)
+				continue;
+			openPermissionsAt(path + "/" + e->d_name, depth + 1);
+		}
+		closedir(d);
+	}
+	else if (S_ISREG(st.st_mode))
+	{
+		if ((st.st_mode & 0666) != 0666)
+			chmod(path.c_str(), (st.st_mode & 0777) | 0666);
+	}
+}
+
+void openDataPermissions()
+{
+	umask(0);
+	mkdir(LOVE_PS4_DATA_DIR, 0777);
+	const char *marker = LOVE_PS4_DATA_DIR "/.permissions-v1";
+	struct stat st;
+	if (stat(marker, &st) == 0)
+	{
+		chmod(LOVE_PS4_DATA_DIR, 0777);
+		openPermissionsAt(LOVE_PS4_DATA_DIR "/cache", 0);
+		return;
+	}
+	openPermissionsAt(LOVE_PS4_DATA_DIR, 0);
+	if (FILE *f = std::fopen(marker, "w"))
+		std::fclose(f);
+}
+
+int showMessageBox(const std::string &title, const std::string &message)
+{
+	std::printf("[love] %s: %s\n", title.c_str(), message.c_str());
+	return 0;
+}
+
+} // ps4
+} // love
+
+#endif // LOVE_PS4
