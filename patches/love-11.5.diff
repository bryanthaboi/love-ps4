+/**
+ * Capa de plataforma PS4 (Orbis) para LOVE 11.5.
+ * Equivalente de src/common/nx.cpp del port de Switch, sin lo que aqui no aplica:
+ * no hay touch (asi que no se sintetizan eventos de mouse) y no se toca
+ * aligned_alloc (posix_memalign existe en este SDK).
+ **/
+#ifndef LOVE_PS4_H
+#define LOVE_PS4_H
+
+#include "config.h"
+#ifdef LOVE_PS4
+
+#include <string>
+
+namespace love
+{
+namespace ps4
+{
+
+/// Ruta del ejecutable. No hay /proc en Orbis.
+std::string getExecutablePath();
+
+/// Directorio escribible del titulo. Se crea si no existe.
+std::string getUserDirectory();
+
+/// Busca el .love que la consola debe ejecutar: /app0/game.love, luego
+/// /app0/main.lua (modo directorio). Devuelve "" si no hay ninguno.
+/// Es el mecanismo por el que el titulo arranca sin linea de comandos.
+std::string getLoveInResources(bool &fused);
+
+/// Abre permisos (directorios 0777, archivos 0666) en todo LOVE_PS4_DATA_DIR.
+void openDataPermissions();
+
+/// SDL no tiene messagebox en esta plataforma; se reporta por log.
+int showMessageBox(const std::string &title, const std::string &message);
+
+} // ps4
+} // love
+
+#endif // LOVE_PS4
+#endif // LOVE_PS4_H
